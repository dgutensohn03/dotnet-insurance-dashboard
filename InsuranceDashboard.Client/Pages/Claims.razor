@page "/claims"
@inject IInsuranceDataService DataService
<PageTitle>Claims</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Claims operations</div><h1>Claims</h1><p>Prioritize exposure, investigate losses, and retain claim history through recoverable lifecycle states.</p></div><button class="button-primary" @onclick="()=>showCreate=true">+ New claim</button></div>
<div class="toolbar toolbar-claims"><input aria-label="Search claims" placeholder="Search claim or policy…" @bind="search" @bind:event="oninput"/><select aria-label="Filter by status" @bind="status"><option value="">All statuses</option><option>Open</option><option>Investigating</option><option>Pending</option><option>Closed</option></select><select aria-label="Filter by severity" @bind="severity"><option value="">All severities</option><option value="high">High exposure ($25K+)</option><option value="medium">Medium ($10K–$25K)</option><option value="low">Low (under $10K)</option></select><select aria-label="Filter claim lifecycle" @bind="lifecycle"><option value="active">Active</option><option value="archived">Archived</option><option value="all">All records</option></select><button class="button-secondary" @onclick="ClearFilters">Clear filters</button><span>@Filtered.Count() claims</span></div>
<div class="column-filters"><label>Loss from<input type="date" @bind="lossFrom"/></label><label>Loss through<input type="date" @bind="lossTo"/></label><label>Min exposure<input type="number" min="0" placeholder="$0" @bind="minExposure"/></label><label>Max exposure<input type="number" min="0" placeholder="Any" @bind="maxExposure"/></label></div>
<section class="panel flush">@if(claims is null){<div aria-label="Loading claims" aria-busy="true" class="loading-table"><div class="skeleton-line"></div><div class="skeleton-line"></div></div>}else{<div class="table-wrap"><table><thead><tr><th><button class="sort-header" @onclick='()=>Sort("claim")'>Claim @SortMark("claim")</button></th><th><button class="sort-header" @onclick='()=>Sort("policy")'>Policy @SortMark("policy")</button></th><th><button class="sort-header" @onclick='()=>Sort("status")'>Status @SortMark("status")</button></th><th><button class="sort-header" @onclick='()=>Sort("loss")'>Loss date @SortMark("loss")</button></th><th><button class="sort-header" @onclick='()=>Sort("severity")'>Severity @SortMark("severity")</button></th><th><button class="sort-header" @onclick='()=>Sort("exposure")'>Exposure @SortMark("exposure")</button></th><th><button class="sort-header" @onclick='()=>Sort("lifecycle")'>Lifecycle @SortMark("lifecycle")</button></th></tr></thead><tbody>@foreach(var c in Filtered.Take(75)){<tr class="clickable-row @(selectedClaim?.Id==c.Id?"row-selected":"")" @onclick="()=>selectedClaim=c"><td><strong>@c.ClaimNumber</strong></td><td>@c.PolicyNumber</td><td><StatusPill Text="@c.Status"/></td><td>@c.LossDate.ToString("MMM d, yyyy")</td><td><span class="severity @Severity(c.Amount).ToLowerInvariant()">@Severity(c.Amount)</span></td><td><strong>@c.Amount.ToString("C0")</strong></td><td><span class="status-pill @(c.IsArchived?"status-muted":"status-good")">@(c.IsArchived?"Archived":"Active")</span></td></tr>}</tbody></table></div>}</section>
@if(selectedClaim is not null){<aside class="detail-drawer claim-drawer" aria-label="Claim details"><div class="drawer-heading"><div><div class="eyebrow">Claim detail</div><h2>@selectedClaim.ClaimNumber</h2><p>@selectedClaim.PolicyNumber · @selectedClaim.LossDate.ToString("MMM d, yyyy")</p></div><button class="icon-button" aria-label="Close claim drawer" @onclick="()=>selectedClaim=null">Close</button></div><div class="lifecycle-banner @(selectedClaim.IsArchived?"archived":"active")"><strong>@(selectedClaim.IsArchived?"Archived claim":"Active claim")</strong><span>@(selectedClaim.IsArchived?$"Archived {selectedClaim.ArchivedAt?.ToLocalTime():MMM d, yyyy}":"Included in active operational metrics")</span></div><div class="detail-hero"><strong class="drawer-amount">@selectedClaim.Amount.ToString("C0")</strong><span class="severity @Severity(selectedClaim.Amount).ToLowerInvariant()">@Severity(selectedClaim.Amount) exposure</span></div><dl class="detail-list"><div><dt>Status</dt><dd><StatusPill Text="@selectedClaim.Status"/></dd></div><div><dt>Policy</dt><dd>@selectedClaim.PolicyNumber</dd></div><div><dt>Loss date</dt><dd>@selectedClaim.LossDate.ToString("MMM d, yyyy")</dd></div><div><dt>Last updated</dt><dd>@selectedClaim.LastUpdatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</dd></div></dl><div class="form-actions">@if(!selectedClaim.IsArchived){<button class="button-secondary" @onclick="()=>BeginEdit(selectedClaim)">Edit claim</button><button class="danger-link" @onclick="()=>archiveTarget=selectedClaim">Archive claim</button>}else{<button class="button-primary" @onclick="RestoreSelected">Restore claim</button>}</div></aside>}
@if(showCreate){<div class="modal-backdrop" @onclick="CloseCreate"><section class="modal-card modal-wide" role="dialog" aria-modal="true" aria-labelledby="claim-modal-title" @onclick:stopPropagation><div class="modal-heading"><div><div class="eyebrow">Claim intake</div><h2 id="claim-modal-title">Create claim</h2></div><button class="modal-close" aria-label="Close claim form" @onclick="CloseCreate">×</button></div><EditForm Model="newClaim" OnValidSubmit="HandleValidSubmit"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid form-grid-two"><label>Claim number<InputText @bind-Value="newClaim.ClaimNumber"/></label><label>Policy number<InputText @bind-Value="newClaim.PolicyNumber"/></label><label>Status<InputSelect @bind-Value="newClaim.Status"><option>Open</option><option>Investigating</option><option>Pending</option><option>Closed</option></InputSelect></label><label>Exposure<InputNumber @bind-Value="newClaim.Amount"/></label><label>Loss date<InputDate @bind-Value="newClaim.LossDate"/></label></div><div class="form-actions"><button type="button" class="button-secondary" @onclick="CloseCreate">Cancel</button><button class="button-primary" type="submit" disabled="@saving">@(saving?"Saving…":"Create claim")</button></div></EditForm></section></div>}
@if(editClaim is not null){<div class="modal-backdrop" @onclick="CloseEdit"><section class="modal-card modal-wide" role="dialog" aria-modal="true" aria-labelledby="edit-claim-title" @onclick:stopPropagation><div class="modal-heading"><div><div class="eyebrow">Claim maintenance</div><h2 id="edit-claim-title">Edit @editClaim.ClaimNumber</h2></div><button class="modal-close" aria-label="Close edit claim form" @onclick="CloseEdit">×</button></div><EditForm Model="editClaim" OnValidSubmit="SaveEdit"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid form-grid-two"><label>Claim number<input value="@editClaim.ClaimNumber" disabled /></label><label>Policy number<InputText @bind-Value="editClaim.PolicyNumber"/></label><label>Status<InputSelect @bind-Value="editClaim.Status"><option>Open</option><option>Investigating</option><option>Pending</option><option>Closed</option></InputSelect></label><label>Exposure<InputNumber @bind-Value="editClaim.Amount"/></label><label>Loss date<InputDate @bind-Value="editClaim.LossDate"/></label></div><div class="form-actions"><button type="button" class="button-secondary" @onclick="CloseEdit">Cancel</button><button class="button-primary" type="submit" disabled="@saving">@(saving?"Saving…":"Save changes")</button></div></EditForm></section></div>}
@if(archiveTarget is not null){<div class="modal-backdrop modal-top"><section class="confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="archive-claim-title"><div class="eyebrow">Recoverable lifecycle action</div><h2 id="archive-claim-title">Archive @archiveTarget.ClaimNumber?</h2><p>The claim will leave active operations and KPI calculations while remaining recoverable.</p><div class="form-actions"><button class="button-secondary" @onclick="()=>archiveTarget=null">Cancel</button><button class="button-danger" @onclick="ArchiveConfirmed">Archive claim</button></div></section></div>}
@if(toast is not null){<div class="toast" role="status" aria-live="polite">@toast</div>}
@code{private IReadOnlyList<Claim>? claims;private Claim? selectedClaim;private Claim? archiveTarget;private Claim? editClaim;private Claim newClaim=CreateBlankClaim();private string? toast;private string search="";private string status="";private string severity="";private string lifecycle="active";private decimal? minExposure;private decimal? maxExposure;private DateOnly? lossFrom;private DateOnly? lossTo;private string sort="exposure";private bool ascending=false;private bool saving;private bool showCreate;
private IEnumerable<Claim> Filtered{get{var q=(claims??[]).Where(c=>lifecycle=="all"||(lifecycle=="archived"?c.IsArchived:!c.IsArchived)).Where(c=>(string.IsNullOrWhiteSpace(search)||c.ClaimNumber.Contains(search,StringComparison.OrdinalIgnoreCase)||c.PolicyNumber.Contains(search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(status)||c.Status==status)&&(string.IsNullOrWhiteSpace(severity)||(severity=="high"&&c.Amount>=25000)||(severity=="medium"&&c.Amount>=10000&&c.Amount<25000)||(severity=="low"&&c.Amount<10000))).Where(c=>!minExposure.HasValue||c.Amount>=minExposure).Where(c=>!maxExposure.HasValue||c.Amount<=maxExposure).Where(c=>!lossFrom.HasValue||c.LossDate>=lossFrom).Where(c=>!lossTo.HasValue||c.LossDate<=lossTo);return (sort,ascending) switch{("claim",true)=>q.OrderBy(c=>c.ClaimNumber),("claim",false)=>q.OrderByDescending(c=>c.ClaimNumber),("policy",true)=>q.OrderBy(c=>c.PolicyNumber),("policy",false)=>q.OrderByDescending(c=>c.PolicyNumber),("status",true)=>q.OrderBy(c=>c.Status),("status",false)=>q.OrderByDescending(c=>c.Status),("loss",true)=>q.OrderBy(c=>c.LossDate),("loss",false)=>q.OrderByDescending(c=>c.LossDate),("lifecycle",true)=>q.OrderBy(c=>c.IsArchived),("lifecycle",false)=>q.OrderByDescending(c=>c.IsArchived),("exposure",true)=>q.OrderBy(c=>c.Amount),_=>q.OrderByDescending(c=>c.Amount)};}}
protected override async Task OnInitializedAsync()=>claims=await DataService.GetClaimsAsync();private static string Severity(decimal amount)=>amount>=25000?"High":amount>=10000?"Medium":"Low";private void Sort(string key){if(sort==key)ascending=!ascending;else{sort=key;ascending=true;}}private string SortMark(string key)=>sort==key?(ascending?"↑":"↓"):"↕";private void ClearFilters(){search="";status="";severity="";lifecycle="all";minExposure=null;maxExposure=null;lossFrom=null;lossTo=null;}private void CloseCreate(){showCreate=false;newClaim=CreateBlankClaim();}private void BeginEdit(Claim claim)=>editClaim=Clone(claim);private void CloseEdit()=>editClaim=null;private async Task HandleValidSubmit(){saving=true;try{var created=await DataService.AddClaimAsync(newClaim);await Refresh();selectedClaim=(claims??[]).FirstOrDefault(c=>c.Id==created.Id);newClaim=CreateBlankClaim();showCreate=false;Notify($"{created.ClaimNumber} created");}finally{saving=false;}}private async Task SaveEdit(){if(editClaim is null)return;saving=true;try{var updated=await DataService.UpdateClaimAsync(editClaim);editClaim=null;await Refresh();selectedClaim=(claims??[]).FirstOrDefault(c=>c.Id==updated.Id);Notify($"{updated.ClaimNumber} updated · overview metrics will recalculate from this data");}finally{saving=false;}}private async Task ArchiveConfirmed(){if(archiveTarget is null)return;var number=archiveTarget.ClaimNumber;await DataService.ArchiveClaimAsync(archiveTarget.Id);archiveTarget=null;await Refresh();Notify($"{number} archived");}private async Task RestoreSelected(){if(selectedClaim is null)return;var number=selectedClaim.ClaimNumber;await DataService.RestoreClaimAsync(selectedClaim.Id);await Refresh();Notify($"{number} restored");}private async Task Refresh(){claims=await DataService.GetClaimsAsync();if(selectedClaim is not null)selectedClaim=claims.FirstOrDefault(c=>c.Id==selectedClaim.Id);StateHasChanged();}private void Notify(string message){toast=message;_ = ClearToastAsync();}private async Task ClearToastAsync(){await Task.Delay(2600);toast=null;await InvokeAsync(StateHasChanged);}private static Claim Clone(Claim c)=>new(){Id=c.Id,ClaimNumber=c.ClaimNumber,PolicyNumber=c.PolicyNumber,Status=c.Status,Amount=c.Amount,LossDate=c.LossDate,IsArchived=c.IsArchived,ArchivedAt=c.ArchivedAt,LastUpdatedAt=c.LastUpdatedAt};private static Claim CreateBlankClaim()=>new(){ClaimNumber=$"CLM-{Random.Shared.Next(11000,99999)}",PolicyNumber="POL-48392",Status="Open",Amount=0,LossDate=DateOnly.FromDateTime(DateTime.Today)};}
