@page "/claims"
@inject IInsuranceDataService DataService
<PageTitle>Claims</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Claims operations</div><h1>Claims</h1><p>Prioritize exposure, investigate losses, and manage claim intake from one workspace.</p></div><button class="button-primary" @onclick="()=>showCreate=true">+ New claim</button></div>
<div class="toolbar toolbar-wide"><input aria-label="Search claims" placeholder="Search claim or policy…" @bind="search" @bind:event="oninput"/><select aria-label="Filter by status" @bind="status"><option value="">All statuses</option><option>Open</option><option>Investigating</option><option>Pending</option><option>Closed</option></select><select aria-label="Filter by severity" @bind="severity"><option value="">All severities</option><option value="high">High exposure ($25K+)</option><option value="medium">Medium ($10K–$25K)</option><option value="low">Low (under $10K)</option></select><span>@Filtered.Count() claims</span></div>
<section class="panel flush">@if(claims is null){<div class="panel-inner">Loading claims…</div>}else{<div class="table-wrap"><table><thead><tr><th>Claim</th><th>Policy</th><th>Status</th><th>Loss date</th><th>Severity</th><th>Exposure</th></tr></thead><tbody>@foreach(var c in Filtered.Take(75)){<tr class="clickable-row @(selectedClaim?.Id==c.Id?"row-selected":"")" @onclick="()=>selectedClaim=c"><td><strong>@c.ClaimNumber</strong></td><td>@c.PolicyNumber</td><td><StatusPill Text="@c.Status"/></td><td>@c.LossDate.ToString("MMM d, yyyy")</td><td><span class="severity @Severity(c.Amount).ToLowerInvariant()">@Severity(c.Amount)</span></td><td><strong>@c.Amount.ToString("C0")</strong></td></tr>}</tbody></table></div>}</section>
@if(selectedClaim is not null){<aside class="detail-drawer claim-drawer" aria-label="Claim details"><div class="drawer-heading"><div><div class="eyebrow">Claim detail</div><h2>@selectedClaim.ClaimNumber</h2><p>@selectedClaim.PolicyNumber · @selectedClaim.LossDate.ToString("MMM d, yyyy")</p></div><button class="icon-button" aria-label="Close claim details" @onclick="()=>selectedClaim=null">Close</button></div><div class="detail-hero"><strong class="drawer-amount">@selectedClaim.Amount.ToString("C0")</strong><span class="severity @Severity(selectedClaim.Amount).ToLowerInvariant()">@Severity(selectedClaim.Amount) exposure</span></div><dl class="detail-list"><div><dt>Status</dt><dd><StatusPill Text="@selectedClaim.Status"/></dd></div><div><dt>Policy</dt><dd>@selectedClaim.PolicyNumber</dd></div><div><dt>Loss date</dt><dd>@selectedClaim.LossDate.ToString("MMM d, yyyy")</dd></div></dl><div class="timeline"><div class="eyebrow">Workflow milestones</div><div><i></i><span><strong>Claim reviewed</strong><small>Exposure and status evaluated</small></span></div><div><i></i><span><strong>Claim received</strong><small>@selectedClaim.LossDate.ToString("MMM d") · Initial loss reported</small></span></div></div></aside>}
@if(showCreate){<div class="modal-backdrop" @onclick="CloseCreate"><section class="modal-card modal-wide" role="dialog" aria-modal="true" aria-labelledby="claim-modal-title" @onclick:stopPropagation><div class="modal-heading"><div><div class="eyebrow">Claim intake</div><h2 id="claim-modal-title">Create claim</h2><p>Capture the initial loss record. Workflow updates remain auditable rather than deleting claims.</p></div><button class="modal-close" aria-label="Close claim form" @onclick="CloseCreate">×</button></div><EditForm Model="newClaim" OnValidSubmit="HandleValidSubmit"><DataAnnotationsValidator/><ValidationSummary/><div class="form-grid form-grid-two"><label>Claim number<InputText @bind-Value="newClaim.ClaimNumber"/></label><label>Policy number<InputText @bind-Value="newClaim.PolicyNumber"/></label><label>Status<InputSelect @bind-Value="newClaim.Status"><option>Open</option><option>Investigating</option><option>Pending</option><option>Closed</option></InputSelect></label><label>Exposure<InputNumber @bind-Value="newClaim.Amount"/></label></div><div class="form-actions"><button type="button" class="button-secondary" @onclick="CloseCreate">Cancel</button><button class="button-primary" type="submit" disabled="saving">@(saving?"Saving…":"Create claim")</button></div></EditForm></section></div>}
@code{private IReadOnlyList<Claim>? claims;private Claim? selectedClaim;private Claim newClaim=CreateBlankClaim();private string search="";private string status="";private string severity="";private bool saving;private bool showCreate;private IEnumerable<Claim> Filtered=>(claims??[]).Where(c=>(string.IsNullOrWhiteSpace(search)||c.ClaimNumber.Contains(search,StringComparison.OrdinalIgnoreCase)||c.PolicyNumber.Contains(search,StringComparison.OrdinalIgnoreCase))&&(string.IsNullOrWhiteSpace(status)||c.Status==status)&&(string.IsNullOrWhiteSpace(severity)||(severity=="high"&&c.Amount>=25000)||(severity=="medium"&&c.Amount>=10000&&c.Amount<25000)||(severity=="low"&&c.Amount<10000))).OrderByDescending(c=>c.Amount);protected override async Task OnInitializedAsync(){claims=await DataService.GetClaimsAsync();selectedClaim=claims.FirstOrDefault(c=>c.ClaimNumber=="CLM-10482");}private static string Severity(decimal amount)=>amount>=25000?"High":amount>=10000?"Medium":"Low";private void CloseCreate(){showCreate=false;newClaim=CreateBlankClaim();}private async Task HandleValidSubmit(){saving=true;try{var created=await DataService.AddClaimAsync(newClaim);claims=await DataService.GetClaimsAsync();selectedClaim=created;newClaim=CreateBlankClaim();showCreate=false;}finally{saving=false;}}private static Claim CreateBlankClaim()=>new(){ClaimNumber=$"CLM-{Random.Shared.Next(11000,99999)}",PolicyNumber="POL-48392",Status="Open",Amount=0,LossDate=DateOnly.FromDateTime(DateTime.Today)};}
