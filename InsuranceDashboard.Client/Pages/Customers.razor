@page "/customers"
@inject IInsuranceDataService DataService
<PageTitle>Customers</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Customer operations</div><h1>Customers</h1><p>Search relationships, maintain contact data, and manage recoverable customer lifecycle state.</p></div><button class="button-primary" @onclick="StartCreate">+ New customer</button></div>
<div class="toolbar toolbar-lifecycle"><input aria-label="Search customers" placeholder="Search name, email, or state…" @bind="search" @bind:event="oninput"/><select aria-label="Filter customer lifecycle" @bind="lifecycle"><option value="active">Active</option><option value="archived">Archived</option><option value="all">All records</option></select><span>@Filtered.Count() customers</span></div>
@if(customers is null){<div aria-label="Loading customers" aria-busy="true" class="panel loading-table"><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line"></div></div>}else{<section class="panel flush"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>State</th><th>Policies</th><th>Annual premium</th><th>Lifecycle</th><th></th></tr></thead><tbody>@foreach(var c in Filtered.Take(50)){<tr class="clickable-row @(selected?.Id==c.Id?"row-selected":"")" @onclick="()=>Select(c)"><td><div class="person-cell"><span class="avatar">@c.Name[..1]</span><span><strong>@c.Name</strong><small>@c.Email</small></span></div></td><td>@c.State</td><td>@c.PolicyCount</td><td>@c.TotalPremium.ToString("C0")</td><td><span class="status-pill @(c.IsArchived?"status-muted":"status-good")">@(c.IsArchived?"Archived":"Active")</span></td><td><button class="icon-button" aria-label="Edit @c.Name" @onclick:stopPropagation @onclick="()=>Edit(c)" disabled="@c.IsArchived">Edit</button></td></tr>}</tbody></table></div></section>}
@if(selected is not null){<aside class="detail-drawer" aria-label="Customer details"><div class="drawer-heading"><div><div class="eyebrow">Customer detail</div><h2>@selected.Name</h2><p>@selected.Email · @selected.State</p></div><button class="icon-button" aria-label="Close customer details" @onclick="()=>selected=null">Close</button></div><div class="lifecycle-banner @(selected.IsArchived?"archived":"active")"><strong>@(selected.IsArchived?"Archived record":"Active relationship")</strong><span>@(selected.IsArchived?$"Archived {selected.ArchivedAt?.ToLocalTime():MMM d, yyyy}":"Available in active workflows")</span></div><dl class="detail-list"><div><dt>Policies</dt><dd>@selected.PolicyCount</dd></div><div><dt>Annual premium</dt><dd>@selected.TotalPremium.ToString("C0")</dd></div><div><dt>Last updated</dt><dd>@selected.LastUpdatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</dd></div></dl><div class="form-actions">@if(selected.IsArchived){<button class="button-primary" @onclick="RestoreSelected">Restore customer</button>}else{<button class="button-secondary" @onclick="()=>Edit(selected)">Edit customer</button><button class="danger-link" @onclick="()=>archiveTarget=Clone(selected)">Archive</button>}</div></aside>}
@if(editing is not null){<div class="modal-backdrop" @onclick="Cancel"><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="customer-modal-title" @onclick:stopPropagation><div class="modal-heading"><div><div class="eyebrow">@(editing.Id==0?"Customer intake":"Customer maintenance")</div><h2 id="customer-modal-title">@(editing.Id==0?"Create customer":"Edit customer")</h2><p>@(editing.Id==0?"Add a customer relationship to the operations workspace.":$"Update {editing.Name}'s contact information.")</p></div><button class="modal-close" aria-label="Close customer form" @onclick="Cancel">×</button></div><EditForm Model="editing" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="stack-form"><label>Full name<InputText @bind-Value="editing.Name"/></label><label>Email<InputText @bind-Value="editing.Email"/></label><label>State<InputText @bind-Value="editing.State" maxlength="2"/></label></div><div class="form-actions"><button type="button" class="button-secondary" @onclick="Cancel">Cancel</button><button type="submit" class="button-primary" disabled="@saving">@(saving?"Saving…":editing.Id==0?"Create customer":"Save changes")</button></div></EditForm></section></div>}
@if(archiveTarget is not null){<div class="modal-backdrop modal-top"><section class="confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="archive-title"><div class="eyebrow">Recoverable lifecycle action</div><h2 id="archive-title">Archive @archiveTarget.Name?</h2><p>The customer will leave active workflows but remain retained and recoverable. Linked policy history is preserved.</p><div class="form-actions"><button class="button-secondary" @onclick="()=>archiveTarget=null">Cancel</button><button class="button-danger" @onclick="ArchiveConfirmed">Archive customer</button></div></section></div>}
@if(toast is not null){<div class="toast" role="status" aria-live="polite">@toast</div>}
@code{private IReadOnlyList<Customer>? customers;private Customer? selected;private Customer? editing;private Customer? archiveTarget;private string? toast;private string search="";private string lifecycle="active";private bool saving;private IEnumerable<Customer> Filtered=>(customers??[]).Where(c=>lifecycle=="all"||(lifecycle=="archived"?c.IsArchived:!c.IsArchived)).Where(c=>string.IsNullOrWhiteSpace(search)||c.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||c.Email.Contains(search,StringComparison.OrdinalIgnoreCase)||c.State.Contains(search,StringComparison.OrdinalIgnoreCase));protected override async Task OnInitializedAsync()=>customers=await DataService.GetCustomersAsync();private void StartCreate()=>editing=new Customer();private void Select(Customer c)=>selected=Clone(c);private void Edit(Customer c){if(!c.IsArchived)editing=Clone(c);}private void Cancel()=>editing=null;private async Task Save(){if(editing is null)return;saving=true;var creating=editing.Id==0;try{if(creating)await DataService.AddCustomerAsync(editing);else await DataService.UpdateCustomerAsync(editing);await Refresh();editing=null;Notify(creating?"Customer created":"Customer changes saved");}finally{saving=false;}}private async Task ArchiveConfirmed(){if(archiveTarget is null)return;var name=archiveTarget.Name;await DataService.ArchiveCustomerAsync(archiveTarget.Id);archiveTarget=null;await Refresh();Notify($"{name} archived");}private async Task RestoreSelected(){if(selected is null)return;var name=selected.Name;await DataService.RestoreCustomerAsync(selected.Id);await Refresh();Notify($"{name} restored");}private async Task Refresh(){customers=await DataService.GetCustomersAsync();if(selected is not null)selected=customers.FirstOrDefault(c=>c.Id==selected.Id);StateHasChanged();}private void Notify(string message){toast=message;_ = ClearToastAsync();}private async Task ClearToastAsync(){await Task.Delay(2600);toast=null;await InvokeAsync(StateHasChanged);}private static Customer Clone(Customer c)=>new(c.Id,c.Name,c.Email,c.State,c.PolicyCount,c.TotalPremium){IsArchived=c.IsArchived,ArchivedAt=c.ArchivedAt,LastUpdatedAt=c.LastUpdatedAt};}
