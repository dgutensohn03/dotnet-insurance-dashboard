@page "/customers"
@inject IInsuranceDataService DataService
<PageTitle>Customers</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Customer operations</div><h1>Customers</h1><p>Search customer relationships, review portfolio value, and maintain customer records.</p></div><button class="button-primary" @onclick="StartCreate">+ New customer</button></div>
<div class="toolbar"><input aria-label="Search customers" placeholder="Search name, email, or state…" @bind="search" @bind:event="oninput"/><span>@Filtered.Count() customers</span></div>
@if(customers is null){<div class="panel">Loading customers…</div>}else{<section class="panel flush"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>State</th><th>Policies</th><th>Annual premium</th><th></th></tr></thead><tbody>@foreach(var c in Filtered.Take(50)){<tr class="clickable-row @(selected?.Id==c.Id?"row-selected":"")" @onclick="()=>Select(c)"><td><div class="person-cell"><span class="avatar">@c.Name[..1]</span><span><strong>@c.Name</strong><small>@c.Email</small></span></div></td><td>@c.State</td><td>@c.PolicyCount</td><td>@c.TotalPremium.ToString("C0")</td><td><button class="icon-button" aria-label="Edit @c.Name" @onclick:stopPropagation @onclick="()=>Edit(c)">Edit</button></td></tr>}</tbody></table></div></section>}
@if(selected is not null){<aside class="detail-drawer" aria-label="Customer details"><div class="drawer-heading"><div><div class="eyebrow">Customer detail</div><h2>@selected.Name</h2><p>@selected.Email · @selected.State</p></div><button class="icon-button" aria-label="Close customer details" @onclick="()=>selected=null">Close</button></div><dl class="detail-list"><div><dt>Policies</dt><dd>@selected.PolicyCount</dd></div><div><dt>Annual premium</dt><dd>@selected.TotalPremium.ToString("C0")</dd></div></dl><div class="form-actions"><button class="button-primary" @onclick="()=>Edit(selected)">Edit customer</button></div></aside>}
@if(editing is not null){<div class="modal-backdrop" @onclick="Cancel"><section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="customer-modal-title" @onclick:stopPropagation><div class="modal-heading"><div><div class="eyebrow">@(editing.Id==0?"Customer intake":"Customer maintenance")</div><h2 id="customer-modal-title">@(editing.Id==0?"Create customer":"Edit customer")</h2><p>@(editing.Id==0?"Add a customer relationship to the operations workspace.":$"Update {editing.Name}'s contact information.")</p></div><button class="modal-close" aria-label="Close customer form" @onclick="Cancel">×</button></div><EditForm Model="editing" OnValidSubmit="Save"><DataAnnotationsValidator/><ValidationSummary/><div class="stack-form"><label>Full name<InputText @bind-Value="editing.Name"/></label><label>Email<InputText @bind-Value="editing.Email"/></label><label>State<InputText @bind-Value="editing.State" maxlength="2"/></label></div><div class="form-actions"><button type="button" class="button-secondary" @onclick="Cancel">Cancel</button><button type="submit" class="button-primary" disabled="@saving">@(saving?"Saving…":editing.Id==0?"Create customer":"Save changes")</button></div></EditForm>@if(editing.Id>0){<div class="modal-danger"><div><strong>Customer lifecycle</strong><p>Records with linked policies are protected from deletion. Empty demo records can be removed.</p></div><button class="danger-link" @onclick="RequestDelete">Delete customer</button></div>}</section></div>}
@if(deleteTarget is not null){<div class="modal-backdrop modal-top"><section class="confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="delete-title"><div class="eyebrow">Confirm destructive action</div><h2 id="delete-title">Delete @deleteTarget.Name?</h2>@if(deleteTarget.PolicyCount>0){<p>This customer has @deleteTarget.PolicyCount linked policies, so the record cannot be deleted. In a production system this relationship would be archived or deactivated instead.</p><div class="form-actions"><button class="button-primary" @onclick="()=>deleteTarget=null">Keep customer</button></div>}else{<p>This removes the demo customer record. This action cannot be undone during the current session.</p><div class="form-actions"><button class="button-secondary" @onclick="()=>deleteTarget=null">Cancel</button><button class="button-danger" @onclick="DeleteConfirmed">Delete customer</button></div>}</section></div>}
@code{private IReadOnlyList<Customer>? customers;private Customer? selected;private Customer? editing;private Customer? deleteTarget;private string search="";private bool saving;private IEnumerable<Customer> Filtered=>customers?.Where(c=>string.IsNullOrWhiteSpace(search)||c.Name.Contains(search,StringComparison.OrdinalIgnoreCase)||c.Email.Contains(search,StringComparison.OrdinalIgnoreCase)||c.State.Contains(search,StringComparison.OrdinalIgnoreCase))??[];protected override async Task OnInitializedAsync()=>customers=await DataService.GetCustomersAsync();private void StartCreate()=>editing=new Customer();private void Select(Customer c)=>selected=Clone(c);private void Edit(Customer c)=>editing=Clone(c);private void Cancel()=>editing=null;private void RequestDelete(){if(editing is null)return;deleteTarget=Clone(editing);}private async Task Save(){if(editing is null)return;saving=true;try{if(editing.Id==0)await DataService.AddCustomerAsync(editing);else await DataService.UpdateCustomerAsync(editing);customers=await DataService.GetCustomersAsync();selected=editing.Id==0?null:customers.FirstOrDefault(c=>c.Id==editing.Id);editing=null;}finally{saving=false;}}private async Task DeleteConfirmed(){if(deleteTarget is null||deleteTarget.Id==0||deleteTarget.PolicyCount>0)return;await DataService.DeleteCustomerAsync(deleteTarget.Id);customers=await DataService.GetCustomersAsync();if(selected?.Id==deleteTarget.Id)selected=null;deleteTarget=null;editing=null;}private static Customer Clone(Customer c)=>new(c.Id,c.Name,c.Email,c.State,c.PolicyCount,c.TotalPremium);}
