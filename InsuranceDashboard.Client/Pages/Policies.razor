@page "/policies"
@inject IInsuranceDataService DataService
<PageTitle>Policies</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Policy administration</div><h1>Policies</h1><p>Review active coverage, premium mix, and policy status across the book of business.</p></div></div>
<div class="toolbar toolbar-policy"><input aria-label="Search policies" placeholder="Search policy, customer, or product…" @bind="search" @bind:event="oninput"/><select aria-label="Filter policy status" @bind="status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="all">All policies</option></select><select aria-label="Filter product" @bind="type"><option value="">All products</option>@foreach(var product in ProductTypes){<option>@product</option>}</select><span>@FilteredPolicies.Count() policies</span></div>
@if(policies is null){<div class="panel">Loading policies…</div>}else{<div class="policy-summary-grid"><div class="panel"><div class="eyebrow">Active premium</div><div class="metric-value">@ActiveAnnualPremium.ToString("C0")</div><div class="metric-detail">Annualized active portfolio</div></div><div class="panel"><div class="eyebrow">Active policies</div><div class="metric-value">@policies.Count(p=>p.Active).ToString("N0")</div><div class="metric-detail">Currently in force</div></div><div class="panel"><div class="eyebrow">Average monthly premium</div><div class="metric-value">@AverageMonthlyPremium.ToString("C0")</div><div class="metric-detail">Across active policies</div></div></div><section class="panel flush"><div class="table-wrap"><table><thead><tr><th>Policy</th><th>Customer</th><th>Product</th><th>Monthly premium</th><th>Effective</th><th>Status</th></tr></thead><tbody>@foreach(var policy in FilteredPolicies.Take(100)){<tr><td><strong>@policy.PolicyNumber</strong></td><td>@policy.CustomerName</td><td>@policy.Type</td><td>@policy.Premium.ToString("C0")</td><td>@policy.EffectiveDate.ToString("MMM d, yyyy")</td><td><StatusPill Text="@(policy.Active?"Active":"Inactive")"/></td></tr>}</tbody></table></div></section>}
@code{private IReadOnlyList<Policy>? policies;private string search="";private string status="active";private string type="";private IEnumerable<string> ProductTypes=>(policies??[]).Select(p=>p.Type).Distinct().OrderBy(x=>x);private IEnumerable<Policy> FilteredPolicies=>(policies??[]).Where(p=>status=="all"||(status=="active"?p.Active:!p.Active)).Where(p=>string.IsNullOrWhiteSpace(type)||p.Type==type).Where(p=>string.IsNullOrWhiteSpace(search)||p.PolicyNumber.Contains(search,StringComparison.OrdinalIgnoreCase)||p.CustomerName.Contains(search,StringComparison.OrdinalIgnoreCase)||p.Type.Contains(search,StringComparison.OrdinalIgnoreCase)).OrderByDescending(p=>p.Premium);private decimal ActiveAnnualPremium=>(policies??[]).Where(p=>p.Active).Sum(p=>p.Premium)*12m;private decimal AverageMonthlyPremium=>(policies??[]).Where(p=>p.Active).Select(p=>p.Premium).DefaultIfEmpty().Average();protected override async Task OnInitializedAsync()=>policies=await DataService.GetPoliciesAsync();}
