@page "/policies"
@inject IInsuranceDataService DataService
<PageTitle>Policies</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Policy administration</div><h1>Policies</h1><p>Review active coverage, premium mix, and policy status across the book of business.</p></div></div>
<div class="toolbar toolbar-policy"><input aria-label="Search policies" placeholder="Search policy, customer, or product…" @bind="search" @bind:event="oninput"/><select aria-label="Filter policy status" @bind="status"><option value="active">Active</option><option value="inactive">Inactive</option><option value="all">All policies</option></select><select aria-label="Filter product" @bind="type"><option value="">All products</option>@foreach(var product in ProductTypes){<option>@product</option>}</select><button class="button-secondary" @onclick="ClearFilters">Clear filters</button><span>@FilteredPolicies.Count() policies</span></div>
<div class="column-filters" aria-label="Policy column filters"><label>Min premium<input type="number" min="0" placeholder="$0" @bind="minPremium"/></label><label>Max premium<input type="number" min="0" placeholder="Any" @bind="maxPremium"/></label><label>Effective from<input type="date" @bind="effectiveFrom"/></label><label>Effective through<input type="date" @bind="effectiveTo"/></label></div>
@if(policies is null){<div aria-label="Loading policies" aria-busy="true"><div class="policy-summary-grid">@for(var i=0;i<3;i++){<div class="skeleton-card"></div>}</div><div class="panel loading-table"><div class="skeleton-line"></div><div class="skeleton-line"></div></div></div>}else{<div class="policy-summary-grid"><div class="panel"><div class="eyebrow">Active premium</div><div class="metric-value">@ActiveAnnualPremium.ToString("C0")</div><div class="metric-detail">Annualized active portfolio</div></div><div class="panel"><div class="eyebrow">Active policies</div><div class="metric-value">@policies.Count(p=>p.Active).ToString("N0")</div><div class="metric-detail">Currently in force</div></div><div class="panel"><div class="eyebrow">Average monthly premium</div><div class="metric-value">@AverageMonthlyPremium.ToString("C0")</div><div class="metric-detail">Across active policies</div></div></div><section class="panel flush"><div class="table-wrap"><table><thead><tr><th><button class="sort-header" @onclick='()=>Sort("policy")'>Policy @SortMark("policy")</button></th><th><button class="sort-header" @onclick='()=>Sort("customer")'>Customer @SortMark("customer")</button></th><th><button class="sort-header" @onclick='()=>Sort("product")'>Product @SortMark("product")</button></th><th><button class="sort-header" @onclick='()=>Sort("premium")'>Monthly premium @SortMark("premium")</button></th><th><button class="sort-header" @onclick='()=>Sort("effective")'>Effective @SortMark("effective")</button></th><th><button class="sort-header" @onclick='()=>Sort("status")'>Status @SortMark("status")</button></th></tr></thead><tbody>@foreach(var policy in FilteredPolicies.Take(100)){<tr class="clickable-row @(selectedPolicy?.Id==policy.Id?"row-selected":"")" @onclick="()=>selectedPolicy=policy"><td><strong>@policy.PolicyNumber</strong></td><td>@policy.CustomerName</td><td>@policy.Type</td><td>@policy.Premium.ToString("C0")</td><td>@policy.EffectiveDate.ToString("MMM d, yyyy")</td><td><StatusPill Text="@(policy.Active?"Active":"Inactive")"/></td></tr>}</tbody></table></div></section>}
@if(selectedPolicy is not null){<aside class="detail-drawer" aria-label="Policy details"><div class="drawer-heading"><div><div class="eyebrow">Policy detail</div><h2>@selectedPolicy.PolicyNumber</h2><p>@selectedPolicy.CustomerName · @selectedPolicy.Type</p></div><button class="icon-button" aria-label="Close policy details" @onclick="()=>selectedPolicy=null">Close</button></div><div class="detail-hero"><strong class="drawer-amount">@selectedPolicy.Premium.ToString("C0")<small>/mo</small></strong><StatusPill Text="@(selectedPolicy.Active?"Active":"Inactive")"/></div><dl class="detail-list"><div><dt>Customer</dt><dd>@selectedPolicy.CustomerName</dd></div><div><dt>Product</dt><dd>@selectedPolicy.Type</dd></div><div><dt>Effective date</dt><dd>@selectedPolicy.EffectiveDate.ToString("MMM d, yyyy")</dd></div><div><dt>Annualized premium</dt><dd>@((selectedPolicy.Premium*12m).ToString("C0"))</dd></div></dl><div class="form-actions"><button class="button-primary" @onclick="()=>BeginEdit(selectedPolicy)">Edit policy</button></div></aside>}
@if(editPolicy is not null){<div class="modal-backdrop" @onclick="CloseEdit"><section class="modal-card modal-wide" role="dialog" aria-modal="true" aria-labelledby="edit-policy-title" @onclick:stopPropagation><div class="modal-heading"><div><div class="eyebrow">Policy maintenance</div><h2 id="edit-policy-title">Edit @editPolicy.PolicyNumber</h2><p>Policy number remains fixed while customer, product, premium, effective date, and status can be maintained.</p></div><button class="modal-close" aria-label="Close policy form" @onclick="CloseEdit">×</button></div><EditForm Model="editPolicy" OnValidSubmit="SaveEdit"><div class="form-grid form-grid-two"><label>Policy number<input value="@editPolicy.PolicyNumber" disabled /></label><label>Customer<InputText @bind-Value="editPolicy.CustomerName"/></label><label>Product<InputSelect @bind-Value="editPolicy.Type"><option>Auto</option><option>Home</option><option>Renters</option><option>Umbrella</option></InputSelect></label><label>Monthly premium<InputNumber @bind-Value="editPolicy.Premium"/></label><label>Effective date<InputDate @bind-Value="editPolicy.EffectiveDate"/></label><label>Status<InputSelect @bind-Value="editPolicy.Active"><option value="true">Active</option><option value="false">Inactive</option></InputSelect></label></div><div class="form-actions"><button type="button" class="button-secondary" @onclick="CloseEdit">Cancel</button><button type="submit" class="button-primary" disabled="saving">@(saving?"Saving…":"Save changes")</button></div></EditForm></section></div>}
@if(toast is not null){<div class="toast" role="status" aria-live="polite">@toast</div>}
@code{
private IReadOnlyList<Policy>? policies;private Policy? selectedPolicy;private PolicyEditModel? editPolicy;private string? toast;private bool saving;private string search="";private string status="active";private string type="";private decimal? minPremium;private decimal? maxPremium;private DateOnly? effectiveFrom;private DateOnly? effectiveTo;private string sort="premium";private bool ascending=false;
private IEnumerable<string> ProductTypes=>(policies??[]).Select(p=>p.Type).Distinct().OrderBy(x=>x);
private IEnumerable<Policy> FilteredPolicies{get{var q=(policies??[]).Where(p=>status=="all"||(status=="active"?p.Active:!p.Active)).Where(p=>string.IsNullOrWhiteSpace(type)||p.Type==type).Where(p=>string.IsNullOrWhiteSpace(search)||p.PolicyNumber.Contains(search,StringComparison.OrdinalIgnoreCase)||p.CustomerName.Contains(search,StringComparison.OrdinalIgnoreCase)||p.Type.Contains(search,StringComparison.OrdinalIgnoreCase)).Where(p=>!minPremium.HasValue||p.Premium>=minPremium).Where(p=>!maxPremium.HasValue||p.Premium<=maxPremium).Where(p=>!effectiveFrom.HasValue||p.EffectiveDate>=effectiveFrom).Where(p=>!effectiveTo.HasValue||p.EffectiveDate<=effectiveTo);return (sort,ascending) switch{("policy",true)=>q.OrderBy(p=>p.PolicyNumber),("policy",false)=>q.OrderByDescending(p=>p.PolicyNumber),("customer",true)=>q.OrderBy(p=>p.CustomerName),("customer",false)=>q.OrderByDescending(p=>p.CustomerName),("product",true)=>q.OrderBy(p=>p.Type),("product",false)=>q.OrderByDescending(p=>p.Type),("effective",true)=>q.OrderBy(p=>p.EffectiveDate),("effective",false)=>q.OrderByDescending(p=>p.EffectiveDate),("status",true)=>q.OrderBy(p=>p.Active),("status",false)=>q.OrderByDescending(p=>p.Active),("premium",true)=>q.OrderBy(p=>p.Premium),_=>q.OrderByDescending(p=>p.Premium)};}}
private decimal ActiveAnnualPremium=>(policies??[]).Where(p=>p.Active).Sum(p=>p.Premium)*12m;private decimal AverageMonthlyPremium=>(policies??[]).Where(p=>p.Active).Select(p=>p.Premium).DefaultIfEmpty().Average();protected override async Task OnInitializedAsync()=>policies=await DataService.GetPoliciesAsync();private void Sort(string key){if(sort==key)ascending=!ascending;else{sort=key;ascending=true;}}private string SortMark(string key)=>sort==key?(ascending?"↑":"↓"):"↕";private void ClearFilters(){search="";status="all";type="";minPremium=null;maxPremium=null;effectiveFrom=null;effectiveTo=null;}private void BeginEdit(Policy p)=>editPolicy=new(){Id=p.Id,PolicyNumber=p.PolicyNumber,CustomerName=p.CustomerName,Type=p.Type,Premium=p.Premium,Active=p.Active,EffectiveDate=p.EffectiveDate};private void CloseEdit()=>editPolicy=null;private async Task SaveEdit(){if(editPolicy is null)return;saving=true;try{var updated=await DataService.UpdatePolicyAsync(new Policy(editPolicy.Id,editPolicy.PolicyNumber,editPolicy.CustomerName,editPolicy.Type,editPolicy.Premium,editPolicy.Active,editPolicy.EffectiveDate));policies=await DataService.GetPoliciesAsync();selectedPolicy=policies.FirstOrDefault(p=>p.Id==updated.Id);editPolicy=null;Notify($"{updated.PolicyNumber} updated · premium metrics recalculated");}finally{saving=false;}}private void Notify(string message){toast=message;_ = ClearToastAsync();}private async Task ClearToastAsync(){await Task.Delay(2600);toast=null;await InvokeAsync(StateHasChanged);}private sealed class PolicyEditModel{public int Id{get;set;}public string PolicyNumber{get;set;}="";public string CustomerName{get;set;}="";public string Type{get;set;}="Auto";public decimal Premium{get;set;}public bool Active{get;set;}public DateOnly EffectiveDate{get;set;}=DateOnly.FromDateTime(DateTime.Today);}
}
