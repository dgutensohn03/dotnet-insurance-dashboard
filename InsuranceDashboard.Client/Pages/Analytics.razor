@page "/analytics"
@inject IInsuranceDataService DataService
<PageTitle>Analytics</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Portfolio intelligence</div><h1>Analytics</h1><p>Explore product mix, active claim severity, exposure, and operating trends across the fictional portfolio.</p></div></div>
@if(loading){<div class="panel">Calculating analytics…</div>}else{<div class="analytics-grid"><section class="panel"><div class="eyebrow">Product distribution</div><h2>Policies by product</h2>@foreach(var x in policiesByType){<div class="bar-row"><span>@x.Type</span><div class="bar-track"><i style="width:@x.Percent%"></i></div><strong>@x.Count</strong></div>}</section><section class="panel"><div class="eyebrow">Claim severity</div><h2>Active exposure by status</h2>@foreach(var x in exposureByStatus){<div class="analytics-stat"><span><StatusPill Text="@x.Status"/></span><strong>@x.Amount.ToString("C0")</strong></div>}</section><section class="panel"><div class="eyebrow">Risk signal</div><h2>Active severity bands</h2>@foreach(var x in severityBands){<div class="analytics-stat"><span>@x.Label</span><strong>@x.Count</strong></div>}</section><section class="panel"><div class="eyebrow">Portfolio efficiency</div><h2>Operating signals</h2><div class="big-stat"><strong>@averageClaim.ToString("C0")</strong><span>average active claim</span></div><div class="big-stat"><strong>@openRate.ToString("P1")</strong><span>open active claim rate</span></div><div class="big-stat"><strong>@activeRate.ToString("P1")</strong><span>active policy rate</span></div><div class="big-stat"><strong>@archivedClaims.ToString("N0")</strong><span>archived claims retained</span></div></section></div>}
@code{private bool loading=true;private List<(string Type,int Count,int Percent)> policiesByType=[];private List<(string Status,decimal Amount)> exposureByStatus=[];private List<(string Label,int Count)> severityBands=[];private decimal averageClaim;private decimal openRate;private decimal activeRate;private int archivedClaims;protected override async Task OnInitializedAsync(){var policies=await DataService.GetPoliciesAsync();var allClaims=await DataService.GetClaimsAsync();archivedClaims=allClaims.Count(c=>c.IsArchived);var claims=allClaims.Where(c=>!c.IsArchived).ToList();var max=policies.GroupBy(p=>p.Type).Max(g=>g.Count());policiesByType=policies.GroupBy(p=>p.Type).Select(g=>(g.Key,g.Count(),(int)Math.Round(g.Count()*100d/max))).OrderByDescending(x=>x.Item2).ToList();exposureByStatus=claims.GroupBy(c=>c.Status).Select(g=>(g.Key,g.Sum(c=>c.Amount))).OrderByDescending(x=>x.Item2).ToList();severityBands=[("Under $10K",claims.Count(c=>c.Amount<10000)),("$10K–$25K",claims.Count(c=>c.Amount>=10000&&c.Amount<25000)),("$25K–$50K",claims.Count(c=>c.Amount>=25000&&c.Amount<50000)),("$50K+",claims.Count(c=>c.Amount>=50000))];averageClaim=claims.Count==0?0:claims.Average(c=>c.Amount);openRate=claims.Count==0?0:(decimal)claims.Count(c=>c.Status!="Closed")/claims.Count;activeRate=policies.Count==0?0:(decimal)policies.Count(p=>p.Active)/policies.Count;loading=false;}}
